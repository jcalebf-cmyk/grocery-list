{
  "cleanUrls": true,
  "functions": {
    "api/recipe-chat.ts": {
      "maxDuration": 60
    },
    "api/recipe-import.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/r/:code", "destination": "/api/recipe-page?code=:code" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ]
}
