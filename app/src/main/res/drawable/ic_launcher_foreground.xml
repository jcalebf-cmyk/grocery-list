<!-- A grocery tote with a check mark, citrus and a leaf peeking out. Scaled to sit inside the launcher's safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:pivotX="54" android:pivotY="54" android:scaleX="0.8" android:scaleY="0.8">
        <!-- handles, behind the produce -->
        <path
            android:pathData="M39.5,51 C39.5,36 47,30 54,30 C61,30 68.5,36 68.5,51"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.4"
            android:strokeLineCap="round" />
        <!-- citrus -->
        <path android:pathData="M50.5,46.5 a9.5,9.5 0,1 1,19 0 a9.5,9.5 0,1 1,-19 0 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="50.5" android:startY="37" android:endX="69.5" android:endY="56">
                    <item android:offset="0" android:color="#FFFFC56B" />
                    <item android:offset="1" android:color="#FFF28C28" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- leaf -->
        <path android:pathData="M47,53 C41,42 44,31 54,25 C59,35 56,46 47,53 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear" android:startX="41" android:startY="53" android:endX="58" android:endY="25">
                    <item android:offset="0" android:color="#FF7DD87F" />
                    <item android:offset="1" android:color="#FFC6F28A" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:pathData="M48.5,50 C49.5,42 51.5,35 54,29"
            android:strokeColor="#3E9E55"
            android:strokeWidth="1.6"
            android:strokeLineCap="round" />
        <!-- bag -->
        <path android:fillColor="#FFFFFF" android:pathData="M36,50 H72 L75,76 Q75.6,82 69.5,82 H38.5 Q32.4,82 33,76 Z" />
        <path android:fillColor="#E7F3EA" android:pathData="M36,50 H72 L72.6,55 H35.4 Z" />
        <!-- check -->
        <path
            android:pathData="M44.5,66.5 L51,73 L63.5,60.5"
            android:strokeColor="#1F6B3A"
            android:strokeWidth="5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
