<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Recipe share links (https://www.householdgroceries.app/r/…) open the app; the server serves
	     /.well-known/apple-app-site-association. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.householdgroceries.app</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- The app's own group stays first (the default for keychain items); the shared one holds the
	     sign-in the share extension uses (SharedSignIn.swift). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.householdgroceries.app</string>
		<string>$(AppIdentifierPrefix)com.householdgroceries.shared</string>
	</array>
</dict>
</plist>
